@baseUrl = http://localhost:5084

### Get all products
GET {{baseUrl}}/api/products


### Get product by ID
GET {{baseUrl}}/api/products/39

### Create product
POST {{baseUrl}}/api/products
Content-Type: application/json

{
    "name": "Stainless Steel Water Bottle",
    "description": "750ml insulated stainless steel bottle",
    "price": 25.50,
    "stockQuantity": 100,
    "categoryId": 3
}


### Update product
PUT {{baseUrl}}/api/products/39
Content-Type: application/json

{
    "name": "Update id 3",
    "description": "1000ml insulated stainless steel bottle",
    "price": 50.00,
    "stockQuantity": 80,
    "categoryId": 2
}


### Delete product
DELETE {{baseUrl}}/api/products/2